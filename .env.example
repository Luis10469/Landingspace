# Credenciales para scripts/jira-sprint.mjs
# Copia este archivo como .env y completa los valores. .env está en .gitignore: no se sube al repositorio.

# URL del sitio de Jira (sirve también la URL completa del tablero)
JIRA_BASE_URL=https://tu-dominio.atlassian.net
# Correo de la cuenta de Atlassian con la que entras a Jira
JIRA_EMAIL=tu-correo@ejemplo.com
# Token clásico: https://id.atlassian.com/manage-profile/security/api-tokens -> "Crear token de API" (sin alcances)
JIRA_API_TOKEN=
# Clave del proyecto (la de las incidencias: SCRUM-1, SCRUM-2...)
JIRA_PROJECT_KEY=SCRUM
# Número del tablero: el que aparece en la URL .../boards/<número>
JIRA_BOARD_ID=1
